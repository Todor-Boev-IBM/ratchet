        <mxCell id="kTx0GzKM8uGXFho-xpFo-0" parent="dnlcRaWDQPtWidHex5WU-1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=12;align=left;verticalAlign=top;" value="&lt;span style=&quot;&quot;&gt;Models (we are not allowed to select, the best we can do is to detect):&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;ul style=&quot;&quot;&gt;&lt;li&gt;Work well&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Claude Sonnet 4.5+ (Bob 2.0) - for Execute, Commit&lt;/li&gt;&lt;li&gt;Claude Opus 4.5+ (Bob 2.0) - for Load, Capture&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Not so well&lt;/li&gt;&lt;ul&gt;&lt;li&gt;GPT-5 (Bob 1.0/2.0) - for Execute, Commit&lt;/li&gt;&lt;li&gt;Claude Sonnet 3.5/3.7 (Bob 1.0)&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="130" width="400" x="280" y="230" as="geometry" />
        </mxCell>
        <mxCell id="kTx0GzKM8uGXFho-xpFo-1" parent="dnlcRaWDQPtWidHex5WU-1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=12;align=left;verticalAlign=top;" value="&lt;span style=&quot;&quot;&gt;MCPs:&lt;/span&gt;&lt;br style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;ul&gt;&lt;li&gt;Search is a must&lt;b&gt;:&lt;/b&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;ihor-sokoliuk/mcp-searxng&lt;/b&gt;: bad at general search, free&lt;/li&gt;&lt;li&gt;&lt;b&gt;tavily&lt;/b&gt;: best at general search, payed&lt;/li&gt;&lt;li&gt;&lt;b&gt;serper&lt;/b&gt;: good at geneal search, payed&lt;/li&gt;&lt;li&gt;&lt;b&gt;context7&lt;/b&gt;: best at library/code search, payed&lt;/li&gt;&lt;/ul&gt;&lt;li style=&quot;&quot;&gt;Code indexing is useful:&lt;/li&gt;&lt;ul&gt;&lt;li style=&quot;&quot;&gt;&lt;b&gt;codegraph&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="400" x="280" y="400" as="geometry" />
        </mxCell>
        <mxCell id="iB-w_SrWL8gJi0ev0qCv-1" edge="1" parent="dnlcRaWDQPtWidHex5WU-1" source="iB-w_SrWL8gJi0ev0qCv-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;curved=1;endArrow=none;endFill=0;dashed=1;" target="dnlcRaWDQPtWidHex5WU-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="iB-w_SrWL8gJi0ev0qCv-0" parent="dnlcRaWDQPtWidHex5WU-1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=12;align=left;" value="&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;The knive&#39;s edge:&lt;/span&gt;&lt;br&gt;&lt;ul&gt;&lt;li&gt;Reconcile to good quality:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Next loop is easier&lt;/li&gt;&lt;li&gt;The code grows at a steady pace&lt;/li&gt;&lt;li&gt;You fight entropy&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Reconcile to bad quality:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Next loop is harder&lt;/li&gt;&lt;li&gt;The code deteriorates and accelerating pace&lt;/li&gt;&lt;li&gt;You go along with entropy&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;Needs:&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Judgement&lt;/li&gt;&lt;li&gt;Suspiscion&lt;/li&gt;&lt;li&gt;Experience to know what&#39;s &quot;Good enough&quot;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Chasing perfection can offset the benefits of using AI.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Instead look for opportunities to use&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;/create-proposal&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;or &lt;b&gt;/create-plan&lt;/b&gt; to capture technical debt for later.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;This is where AI accelearates the developer you already are.&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="400" x="1360" y="800" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
